meta {
  name: cadastrarVida
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/seguros
  body: json
  auth: inherit
}

headers {
  X-Funcionario-Id: 1
  ~X-Funcionario-Id: 2
}

body:json {
  {
    "titulo": "Seguro de Vida",
    "coberturaMinima": "Morte natural, acidental e invalidez permanente.",
    "valorPremioBase": 200.00,
    "tipo": "VIDA"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
