meta {
  name: cadastrarCelular
  type: http
  seq: 4
}

post {
  url: http://localhost:8080/seguros
  body: json
  auth: inherit
}

headers {
  X-Funcionario-Id: 1
  ~X-Funcionario-Id: 2
}

body:json {
  {
    "titulo": "Seguro Celular Essencial",
    "coberturaMinima": "Apenas roubo e furto qualificado.",
    "valorPremioBase": 45.00,
    "tipo": "CELULAR"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
