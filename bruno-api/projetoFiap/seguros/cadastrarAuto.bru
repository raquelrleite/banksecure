meta {
  name: cadastrarAuto
  type: http
  seq: 3
}

post {
  url: http://localhost:8080/seguros
  body: json
  auth: inherit
}

headers {
  X-Funcionario-Id: 1
  ~X-Funcionario-Id: 2
}

body:json {
  {
    "titulo": "Seguro Auto Total",
    "coberturaMinima": "Colisão, incêndio, roubo e danos a terceiros.",
    "valorPremioBase": 1200.00,
    "tipo": "AUTO"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
